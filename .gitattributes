# Pin all text files to LF in the index so Windows editors that emit CRLF
# do not produce phantom whole-file diffs (Phase 4.1.2 follow-up).
* text=auto eol=lf

# Explicitly text — no autodetection ambiguity:
*.cpp     text eol=lf
*.h       text eol=lf
*.c       text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf

# Binaries:
*.png     binary
*.jpg     binary
*.bin     binary
*.gguf    binary
*.safetensors binary
